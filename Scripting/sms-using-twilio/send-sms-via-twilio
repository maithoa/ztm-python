import os
import requests
from twilio.rest import Client
from pathlib import Path
from dotenv import load_dotenv
from logger_config import get_logger

logger = get_logger(__name__)

def load_twilio_config():
    env_path = Path(__file__).parent.parent / '.env'
    load_dotenv(dotenv_path=env_path)

    TWILIO_ACCOUNT_SID = os.getenv('TWILIO_ACCOUNT_SID')
    TWILIO_AUTH_TOKEN = os.getenv('TWILIO_AUTH_TOKEN')
    TWILIO_PHONE_NUMBER = os.getenv('TWILIO_PHONE_NUMBER')
    TWILIO_API_URL = os.getenv('TWILIO_API_URL')
    TWILIO_CONTENT_SID = os.getenv('TWILIO_CONTENT_SID')

    if not TWILIO_ACCOUNT_SID or not TWILIO_AUTH_TOKEN or not TWILIO_PHONE_NUMBER or not TWILIO_API_URL or not TWILIO_CONTENT_SID:
        logger.error("Twilio configuration is incomplete.")
        raise ValueError("Twilio configuration is incomplete.")

    return TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_PHONE_NUMBER, TWILIO_API_URL, TWILIO_CONTENT_SID


def create_sms(to_phone_number, message_body):
    TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_PHONE_NUMBER, TWILIO_API_URL, TWILIO_CONTENT_SID = load_twilio_config()
    client = Client(TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN)

    try:
        message = client.messages.create(
            from_=TWILIO_PHONE_NUMBER,
            to=to_phone_number,
            content_sid=TWILIO_CONTENT_SID,
            content_variables=message_body
        )
        logger.info("SMS sent successfully to %s", to_phone_number)
        return message.sid
    except Exception as e:
        logger.error("Failed to send SMS to %s: %s", to_phone_number, str(e))
        raise

def post_sms_message(to_phone_number, message_body):
    TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_PHONE_NUMBER, TWILIO_API_URL, TWILIO_CONTENT_SID = load_twilio_config()

    url = (
        f"https://api.twilio.com/2010-04-01/Accounts/"
        f"{TWILIO_ACCOUNT_SID}/Messages.json"
    )

    response = requests.post(
        url,
        auth=(TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN),
        data={
            "To": to_phone_number,
            "From": TWILIO_PHONE_NUMBER,
            "Body": TWILIO_CONTENT_SID,
        },
    )

    response.raise_for_status()
    print(response.status_code, response.text)
    if response.status_code != 201: 
        logger.error("Failed to create SMS via Twillio via POST request: %s", response.text)
        raise ValueError("Failed to create SMS via Twillio POST request")
    logger.info(f"SMS sent successfully via POST request to {to_phone_number} and the message SID is {response.json()['sid']} and status of message is {response.json()['status']}")
    return response.json()["sid"]

def main(to_phone_number, message_body):
    try:
        # message_sid = create_sms(to_phone_number, message_body)
        post_sms_message(to_phone_number, message_body)
        #logger.info("Message SID: %s", message_sid)
    except Exception as e:
        logger.error("Error occurred in main: %s", str(e))
        raise
if __name__ == "__main__":
    import sys
    if len(sys.argv) != 3:
        print("Usage: python send-sms-via-twilio.py <to_phone_number> <message_body>")
        sys.exit(1)

    to_phone_number = sys.argv[1]
    message_body = sys.argv[2]
    main(to_phone_number, message_body)
